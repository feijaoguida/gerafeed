generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NextAuth (Auth.js v5) — padrão oficial @auth/prisma-adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isSuperAdmin  Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceUser[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Multi-tenant — Workspace e WorkspaceUser
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  asaasCustomerId  String?
  stripeCustomerId String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  members          WorkspaceUser[]
  sources          Source[]
  articles         Article[]
  configurations       Configuration[]
  categories           WordPressCategory[]
  wordpressSites       WordPressSite[]
  wordpressSiteSources WordPressSiteSource[]
  subscription         Subscription?
}

// ---------------------------------------------------------------------------
// Billing & Subscriptions
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum FeatureValueType {
  BOOLEAN
  QUANTITY
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  price         Float          @default(0)
  periodicity   String         @default("MONTHLY")
  active        Boolean        @default(true)
  highlight     Boolean        @default(false)
  maxArticles   Int            @default(50)
  maxSources    Int            @default(3)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  planFeatures  PlanFeature[]
}

model Feature {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  valueType   FeatureValueType @default(BOOLEAN)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  planFeatures PlanFeature[]
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean  @default(true)
  limit     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  asaasSubscriptionId  String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  validUntil           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}


model WorkspaceUser {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ---------------------------------------------------------------------------
// Domínio — tabelas existentes com workspaceId
// ---------------------------------------------------------------------------

enum ArticleStatus {
  PENDING
  REJECTED
  PUBLISHED
}

model Source {
  id                   String                @id @default(cuid())
  workspaceId          String
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                 String
  creditName           String?
  rssUrl               String
  defaultPromptType    String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  articles             Article[]
  wordpressSiteSources WordPressSiteSource[]
}

model WordPressCategory {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wordpressSiteId   String?
  wordpressSite     WordPressSite? @relation(fields: [wordpressSiteId], references: [id], onDelete: Cascade)
  wordpressId       Int
  name              String
  slug              String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  suggestedArticles Article[]      @relation("SuggestedCategory")
  selectedArticles  Article[]      @relation("SelectedCategory")

  @@unique([workspaceId, wordpressId])
  @@index([workspaceId])
  @@index([wordpressSiteId])
}

model Article {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId            String
  source              Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  originalUrl         String             @unique
  originalTitle       String
  originalDescription String?
  originalImageUrl    String?
  originalPublishedAt DateTime?
  title               String?
  summary             String?
  content             String?
  suggestedCategoryId String?
  suggestedCategory   WordPressCategory? @relation("SuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            WordPressCategory? @relation("SelectedCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  tags                String[]
  seoFocusKeyword     String?
  seoTitle            String?
  seoDescription      String?
  aiScore             Float?
  status              ArticleStatus      @default(PENDING)
  wordpressPostId     Int?
  wordpressSiteId     String?
  wordpressSite       WordPressSite?     @relation(fields: [wordpressSiteId], references: [id], onDelete: SetNull)
  modifiedImageUrl    String?
  selectedImage       String?            @default("ORIGINAL")
  processedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([workspaceId])
  @@index([sourceId])
  @@index([wordpressSiteId])
  @@index([originalPublishedAt])
}

model Configuration {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
}

model WordPressSite {
  id                           String                @id @default(cuid())
  workspaceId                  String
  workspace                    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                         String
  url                          String
  username                     String
  encryptedApplicationPassword String
  defaultPromptType            String?
  active                       Boolean               @default(true)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  sources                      WordPressSiteSource[]
  categories                   WordPressCategory[]
  articles                     Article[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WordPressSiteSource {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wordpressSiteId    String
  wordpressSite      WordPressSite @relation(fields: [wordpressSiteId], references: [id], onDelete: Cascade)
  sourceId           String
  source             Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  active             Boolean       @default(true)
  promptTypeOverride String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([wordpressSiteId, sourceId])
  @@index([workspaceId])
  @@index([wordpressSiteId])
  @@index([sourceId])
}


